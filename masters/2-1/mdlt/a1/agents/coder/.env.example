# Coder profile: ~/.hermes/profiles/coder/.env
# Copy this file to that location and replace every CHANGE_ME value.
TELEGRAM_BOT_TOKEN=CHANGE_ME_CODER_BOT_TOKEN
TELEGRAM_ALLOWED_USERS=CHANGE_ME_NUMERIC_TELEGRAM_USER_ID
TELEGRAM_GROUP_ALLOWED_CHATS=CHANGE_ME_NEGATIVE_TELEGRAM_GROUP_ID

# Receive the coordinator bot's explicitly addressed task messages.
TELEGRAM_ALLOW_BOTS=mentions
TELEGRAM_REQUIRE_MENTION=true
TELEGRAM_EXCLUSIVE_BOT_MENTIONS=true
TELEGRAM_BOTS_REQUIRE_MENTION=true

# The same OpenRouter key may be used for all three profiles.
OPENROUTER_API_KEY=CHANGE_ME_OPENROUTER_API_KEY

# Optional: Hermes may populate these after a Telegram home channel is selected.
TELEGRAM_HOME_CHANNEL=CHANGE_ME_NEGATIVE_TELEGRAM_GROUP_ID
TELEGRAM_HOME_CHANNEL_THREAD_ID=
